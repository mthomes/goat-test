---
/**
 * The single layout every page renders through, and the single place
 * `src/styles/index.css` is imported. Fleshed out in #10.
 */
import "../styles/index.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
