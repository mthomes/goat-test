---
/**
 * Discoverability metadata: canonical URL, Open Graph, Twitter card, and
 * optional Article structured data.
 *
 * Canonical URLs are absolute and built from `Astro.site` plus the page's own
 * pathname, so they carry the base path the site is actually served from — a
 * canonical that points at a URL nobody can reach is worse than none.
 *
 * Structured data is **microdata**, not JSON-LD. JSON-LD needs a `<script>`
 * tag, and this site ships none — the guardrails in #49 assert that against
 * build output. Microdata expresses the same schema.org types in attributes on
 * the markup that is already there, which costs nothing and keeps the
 * zero-script constraint absolute rather than "absolute apart from one".
 * See `src/pages/releases/[version].astro` for the Article itself.
 */
import { SITE } from "../lib/site.ts";

interface Props {
	title: string;
	description: string;
	/** Present on release pages; switches the Open Graph type to `article`. */
	article?: { published: Date };
}

const { title, description, article } = Astro.props;

// Astro emits directory-style URLs with a trailing slash; the site's own
// links do not carry one, so the canonical is normalised to match. The site
// root keeps its slash, because `https://host/goat-test` and
// `https://host/goat-test/` are the same page and the latter is the served one.
// BASE_URL is not guaranteed to carry a trailing slash, so it is normalised
// here rather than trusted.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonical = new URL(path === base ? `${base}/` : path, Astro.site).href;

---

<link rel="canonical" href={canonical} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_GB" />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
