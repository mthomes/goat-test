---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllReleases, getKnownIssues, getStats } from "../lib/queries.ts";
import { SITE } from "../lib/site.ts";

// Placeholder. The real home page arrives with #27.
const releases = await getAllReleases();
const { open } = await getKnownIssues();
const stats = await getStats();
---

<BaseLayout title={SITE.name} description={SITE.description}>
	<div class="wrapper region stack">
		<h1>{SITE.name}</h1>
		<p>
			{stats.totalReleases} releases, {stats.totalChanges} changes, {open.length} still
			broken. Latest: {releases[0].version}.
		</p>
	</div>
</BaseLayout>
