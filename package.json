{
  "name": "goat-test",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint:style-blocks": "node scripts/lint-style-blocks.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "trace": "node scripts/trace.mjs",
    "trace:sync": "node scripts/sync-requirements.mjs",
    "validate:feed": "node scripts/validate-feed.mjs",
    "test:guardrails": "npm run build && vitest run --config vitest.guardrails.config.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:lighthouse": "npm run build && lhci autorun --config=lighthouserc.cjs",
    "test:visual": "playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/charis-sil": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.1",
    "zod": "^4.4.3"
  },
  "private": true,
  "description": "Release notes for a person.",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
